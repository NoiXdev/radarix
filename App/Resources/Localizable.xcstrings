    "%@ is already added. To add another account, sign in to it on github.com first, or use a token of that account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist schon hinzugefügt. Um ein weiteres Konto hinzuzufügen, melde dich zuerst auf github.com mit diesem Konto an oder nutze einen Token dieses Kontos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is already added. To add another account, sign in to it on github.com first, or use a token of that account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est déjà ajouté. Pour ajouter un autre compte, connectez-vous d’abord à ce compte sur github.com ou utilisez un jeton de ce compte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto %@ jest już dodane. Aby dodać inne konto, najpierw zaloguj się do niego na github.com lub użyj tokenu tego konta."
