    "Classic token: repo and read:org. Fine-grained token: read access to metadata, and read and write access to issues and pull requests, which assigning needs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klassisches Token: repo und read:org. Fine-grained Token: Lesezugriff auf Metadaten sowie Lese- und Schreibzugriff auf Issues und Pull Requests, den das Zuweisen braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic token: repo and read:org. Fine-grained token: read access to metadata, and read and write access to issues and pull requests, which assigning needs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeton classique : repo et read:org. Jeton fine-grained : accès en lecture aux métadonnées, et en lecture et écriture aux issues et pull requests, requis pour l’assignation."
          }
        },
        "pl" : {
          "stringUnit" : {
