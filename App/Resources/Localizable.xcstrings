    "This sign-in can't assign. A fine-grained token needs write access to issues and pull requests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dieser Anmeldung ist das Zuweisen nicht möglich. Ein Fine-grained Token braucht Schreibzugriff auf Issues und Pull Requests."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sign-in can't assign. A fine-grained token needs write access to issues and pull requests."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion ne permet pas d’assigner. Un jeton fine-grained nécessite l’accès en écriture aux issues et pull requests."
          }
        },
        "pl" : {
          "stringUnit" : {
