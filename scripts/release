#!/bin/bash
# Builds, signs, notarizes and staples the Radarix release DMG.
#
#   scripts/release              signed release: dist/Radarix-<version>.dmg
#   scripts/release --unsigned   local layout check only (ad-hoc signed, not
#                                notarized): dist/Radarix-<version>-unsigned.dmg
#
# Unlike macSCP (a SwiftPM build signed piece by piece), Radarix is an Xcode
# project with an embedded WidgetKit extension, so it goes through
# `xcodebuild archive` + `-exportArchive`: Xcode embeds the widget, signs it
# before the app (inside-out) and applies each target's own entitlements.
# Doing that by hand with `codesign` is how a widget ends up unsandboxed or
# outside the App Group, and then it silently shows nothing.
#
# Environment:
#   RADARIX_OAUTH_CLIENT_ID  required, also for --unsigned (pass a dummy
#                            locally). A release without it ships with
#                            "Sign in with GitHub" greyed out.
#   RADARIX_VERSION          the marketing version; CI derives it from the
#                            tag. Locally it falls back to the latest tag.
#   RADARIX_BUILD            the build number; CI passes the run number.
#                            Locally it falls back to the commit count.
#
# Notarization credentials, two modes (auto-detected, signed path only):
#   CI:    APPLE_API_KEY (path to the .p8), APPLE_API_KEY_ID and
#          APPLE_API_ISSUER in the environment — the release workflow
#          prepares these from org secrets.
#   Local: keychain profile "radarix-notary". One-time setup by the
#          maintainer (secrets never touch this repo):
#            xcrun notarytool store-credentials radarix-notary \
#                --apple-id <apple-id> --team-id 5V8ZCK434F
set -euo pipefail
cd "$(dirname "$0")/.."

# The team is fixed, as in macSCP: it is public (it is in every signature),
# and an input would only add a way to sign with the wrong one. It must match
# `teamID` in Config/ExportOptions.plist.
TEAM_ID="5V8ZCK434F"
PROFILE="radarix-notary"
# The App Group the app and the widget share. Xcode expands
# $(TeamIdentifierPrefix) in both entitlements files to "<team>.", so a
# signed build must carry exactly this string, or the widget cannot read
# what the app writes.
APP_GROUP="${TEAM_ID}.dev.noix.radarix"

UNSIGNED=0
for arg in "$@"; do
    case "$arg" in
        --unsigned) UNSIGNED=1 ;;
        -h|--help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "error: unknown argument: $arg (only --unsigned is accepted)" >&2; exit 1 ;;
    esac
done

# --- inputs ----------------------------------------------------------------
# First, before any tool runs: a missing client ID must fail the release, not
# produce a build that looks fine and cannot sign in.
[ -n "${RADARIX_OAUTH_CLIENT_ID:-}" ] || {
    echo "error: RADARIX_OAUTH_CLIENT_ID is empty — a release without it cannot sign in with GitHub" >&2
    echo "  (for a local --unsigned layout check, pass any dummy value)" >&2
    exit 1; }
CLIENT_ID="$RADARIX_OAUTH_CLIENT_ID"

# Version: from RADARIX_VERSION (CI derives it from the tag) or the latest
# local tag — never a hardcoded default that silently mislabels a build.
VERSION="${RADARIX_VERSION:-$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || true)}"
[ -n "$VERSION" ] || { echo "error: no RADARIX_VERSION and no tag to derive it from" >&2; exit 1; }
# X.Y.Z, optionally with a pre-release suffix (1.0.0-rc.1), as the release
# tags are vX.Y.Z[-suffix]. Anything else (a stray "v", "1.2", "release-1")
# would end up in the bundle version and in the DMG name the cask points at.
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || {
    echo "error: version '$VERSION' is not X.Y.Z[-suffix]" >&2; exit 1; }
# The bundle gets the numeric part only: CFBundleShortVersionString is
# documented as plain X.Y.Z, and the app's own version parsing (the update
# check) rejects suffixes. So 1.0.0-rc.1 ships as bundle version 1.0.0,
# while the DMG name, the notary uploads and the log keep the full version.
BUNDLE_VERSION="${VERSION%%-*}"

# Build number: CI passes the workflow run number, which only ever grows.
# The local fallback, the commit count, is deterministic per commit — but a
# shallow CI clone would count 1, which is why CI must not rely on it.
BUILD="${RADARIX_BUILD:-$(git rev-list --count HEAD)}"
[[ "$BUILD" =~ ^[0-9]+$ ]] || { echo "error: build number '$BUILD' is not a positive integer" >&2; exit 1; }

ARCHIVE="dist/Radarix.xcarchive"
EXPORT="dist/export"
APP="dist/Radarix.app"
# Own derived data under dist/: a release never reuses Debug products from
# DerivedData/, and the developer's DerivedData/ stays untouched.
DERIVED="dist/DerivedData"
STAGING="dist/dmg-staging"
if [ "$UNSIGNED" = 1 ]; then
    DMG="dist/Radarix-${VERSION}-unsigned.dmg"
else
    DMG="dist/Radarix-${VERSION}.dmg"
fi

# --- preflight -------------------------------------------------------------
command -v xcodegen >/dev/null || {
    echo "error: xcodegen not found — install it with: brew install xcodegen" >&2; exit 1; }

if [ "$UNSIGNED" = 0 ]; then
    # A release must be reproducible from its tag. --unsigned is exempt: it
    # is the check you run while the change is still uncommitted.
    [ -z "$(git status --porcelain)" ] || {
        echo "error: working tree not clean — commit or stash first" >&2; exit 1; }

    # Look the identity up instead of hardcoding its name: the name carries
    # the holder's name and changes on renewal, the team does not.
    # `-v` lists only valid (unexpired, trusted) identities.
    IDENTITIES="$(security find-identity -v -p codesigning \
        | grep -F 'Developer ID Application:' | grep -F "($TEAM_ID)" || true)"
    [ -n "$IDENTITIES" ] || {
        echo "error: no valid 'Developer ID Application: … ($TEAM_ID)' identity in the keychain" >&2
        exit 1; }
    if [ "$(printf '%s\n' "$IDENTITIES" | wc -l | tr -d ' ')" -gt 1 ]; then
        echo "warning: several Developer ID identities for $TEAM_ID; signing the DMG with the first:" >&2
        printf '%s\n' "$IDENTITIES" >&2
    fi
    # The SHA-1 hash, not the name: two certificates with the same name (an
    # old one and its renewal) would make `codesign --sign <name>` ambiguous.
    IDENTITY_HASH="$(printf '%s\n' "$IDENTITIES" | head -n 1 | awk '{print $2}')"
    IDENTITY_NAME="$(printf '%s\n' "$IDENTITIES" | head -n 1 | sed 's/^[^"]*"\(.*\)"[^"]*$/\1/')"
    echo "identity: $IDENTITY_NAME ($IDENTITY_HASH)"

    if [ -n "${APPLE_API_KEY:-}" ]; then
        # CI mode: App Store Connect API key from the environment.
        [ -n "${APPLE_API_KEY_ID:-}" ] && [ -n "${APPLE_API_ISSUER:-}" ] || {
            echo "error: APPLE_API_KEY is set but APPLE_API_KEY_ID/APPLE_API_ISSUER are missing" >&2
            exit 1; }
        [ -f "$APPLE_API_KEY" ] || {
            echo "error: APPLE_API_KEY must be the path to the .p8 file, and $APPLE_API_KEY does not exist" >&2
            exit 1; }
        NOTARY_AUTH=(--key "$APPLE_API_KEY" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER")
    else
        xcrun notarytool history --keychain-profile "$PROFILE" >/dev/null 2>&1 || {
            echo "error: keychain profile '$PROFILE' missing." >&2
            echo "Create it once (maintainer only):" >&2
            echo "  xcrun notarytool store-credentials $PROFILE --apple-id <apple-id> --team-id $TEAM_ID" >&2
            exit 1; }
        NOTARY_AUTH=(--keychain-profile "$PROFILE")
    fi
fi

echo "Radarix $VERSION (bundle $BUNDLE_VERSION, build $BUILD)$([ "$UNSIGNED" = 1 ] && echo ' — UNSIGNED layout check')"
rm -rf "$ARCHIVE" "$EXPORT" "$APP" "$DERIVED" "$STAGING" "$DMG"
mkdir -p dist

# --- archive ---------------------------------------------------------------
# The project is generated, not committed. Generation takes no release
# settings: they all go on the xcodebuild command line below, where they
# override Base.xcconfig and an optional Local.xcconfig alike. So the
# generated project afterwards is the same one a Debug build uses.
xcodegen generate --quiet

# Universal, so the one DMG (and the cask) covers Apple silicon and Intel.
# The deployment target, macOS 15, still runs on Intel Macs. ONLY_ACTIVE_ARCH
# is NO in Release already; it is spelled out so a Local.xcconfig cannot
# turn it back on.
BUILD_SETTINGS=(
    MARKETING_VERSION="$BUNDLE_VERSION"
    CURRENT_PROJECT_VERSION="$BUILD"
    RADARIX_OAUTH_CLIENT_ID="$CLIENT_ID"
    ENABLE_HARDENED_RUNTIME=YES
    ARCHS="arm64 x86_64"
    ONLY_ACTIVE_ARCH=NO
    CODE_SIGN_STYLE=Manual
)
if [ "$UNSIGNED" = 1 ]; then
    # Ad-hoc, no team. DEVELOPMENT_TEAM is cleared explicitly so a
    # Local.xcconfig with a team cannot sneak real signing into the check.
    BUILD_SETTINGS+=(CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM=)
else
    # The generic "Developer ID Application" plus the team lets Xcode pick
    # the matching certificate itself. Developer ID needs no provisioning
    # profile: the team-prefixed App Group is authorized by the signature's
    # team. Hardened runtime and the secure timestamp are what notarization
    # demands of every executable, the widget included.
    BUILD_SETTINGS+=(
        DEVELOPMENT_TEAM="$TEAM_ID"
        CODE_SIGN_IDENTITY="Developer ID Application"
        OTHER_CODE_SIGN_FLAGS=--timestamp
    )
fi

xcodebuild archive \
    -project Radarix.xcodeproj \
    -scheme Radarix \
    -configuration Release \
    -destination 'generic/platform=macOS' \
    -derivedDataPath "$DERIVED" \
    -archivePath "$ARCHIVE" \
    "${BUILD_SETTINGS[@]}"

# An archive without ApplicationProperties is a "generic" archive (some
# product was installed next to the app instead of inside it). Export would
# then fail with an unhelpful message, so say what is wrong here.
/usr/libexec/PlistBuddy -c 'Print :ApplicationProperties:ApplicationPath' \
    "$ARCHIVE/Info.plist" >/dev/null 2>&1 || {
    echo "error: $ARCHIVE is not an application archive — check SKIP_INSTALL on non-app targets" >&2
    exit 1; }

# --- export ----------------------------------------------------------------
if [ "$UNSIGNED" = 1 ]; then
    # No export: it would re-sign for distribution, which needs the identity.
    # `ditto` keeps the bundle's symlinks, extended attributes and signature.
    ditto "$ARCHIVE/Products/Applications/Radarix.app" "$APP"
else
    # Export re-signs inside-out for Developer ID with the options in
    # Config/ExportOptions.plist (method developer-id, manual, our team).
    xcodebuild -exportArchive \
        -archivePath "$ARCHIVE" \
        -exportPath "$EXPORT" \
        -exportOptionsPlist Config/ExportOptions.plist
    ditto "$EXPORT/Radarix.app" "$APP"
fi

# --- layout checks (both paths) --------------------------------------------
# What the release has to prove beyond "it built": the version and client ID
# really made it into Info.plist, both slices are there, and the widget is
# embedded where macOS looks for it.
fail() { echo "error: $*" >&2; exit 1; }
plist() { /usr/libexec/PlistBuddy -c "Print :$1" "$2" 2>/dev/null || true; }

WIDGET="$APP/Contents/PlugIns/RadarixWidget.appex"
[ -d "$WIDGET" ] || fail "widget extension missing: $WIDGET"

INFO="$APP/Contents/Info.plist"
[ "$(plist CFBundleShortVersionString "$INFO")" = "$BUNDLE_VERSION" ] || fail "app CFBundleShortVersionString is not $BUNDLE_VERSION"
[ "$(plist CFBundleVersion "$INFO")" = "$BUILD" ] || fail "app CFBundleVersion is not $BUILD"
[ "$(plist GitHubOAuthClientID "$INFO")" = "$CLIENT_ID" ] || fail "app GitHubOAuthClientID is not the given client ID"
# The widget must carry the same version: macOS refuses to load an
# extension whose version differs from its host app's.
[ "$(plist CFBundleShortVersionString "$WIDGET/Contents/Info.plist")" = "$BUNDLE_VERSION" ] \
    || fail "widget CFBundleShortVersionString is not $BUNDLE_VERSION"

for bundle in "$APP" "$WIDGET"; do
    exe="$bundle/Contents/MacOS/$(plist CFBundleExecutable "$bundle/Contents/Info.plist")"
    archs="$(lipo -archs "$exe")"
    echo "archs: $archs  ($exe)"
    case " $archs " in
        *" arm64 "*) ;;
        *) fail "$exe has no arm64 slice" ;;
    esac
    case " $archs " in
        *" x86_64 "*) ;;
        *) fail "$exe has no x86_64 slice" ;;
    esac
done

# Print the entitlements of both bundles in the log, so a broken App Group
# is visible at a glance. The ad-hoc build has no team, so its group lacks
# the prefix; only the signed path enforces the exact string.
# `--entitlements - --xml` rather than the older `:-`, which codesign now
# flags as deprecated and "will not work in a future release".
for bundle in "$APP" "$WIDGET"; do
    echo "entitlements: $bundle"
    codesign -d --entitlements - --xml "$bundle"
    echo
    # The group the binary actually opens at runtime: the app and the widget
    # read RadarixAppGroup from their Info.plist, not from the entitlements.
    # Printed on both paths; the signed path asserts it below.
    echo "RadarixAppGroup (Info.plist): '$(plist RadarixAppGroup "$bundle/Contents/Info.plist")'  ($bundle)"
done

if [ "$UNSIGNED" = 1 ]; then
    rm -rf "$STAGING"; mkdir -p "$STAGING"
    cp -R "$APP" "$STAGING/"
    ln -s /Applications "$STAGING/Applications"
    hdiutil create -volname "Radarix" -srcfolder "$STAGING" -ov -format UDZO "$DMG"
    rm -rf "$STAGING"
    echo "UNSIGNED LAYOUT OK: $DMG (ad-hoc signed, not notarized — do not distribute)"
    exit 0
fi

# --- signature checks (signed path) ----------------------------------------
codesign --verify --deep --strict "$APP"
# Reads the entitlements, or fails with codesign's own reason: a bare
# `$(codesign …)` that fails would end the script under `set -e` without a
# word in the CI log.
entitlements() {
    local out
    out="$(codesign -d --entitlements - --xml "$1" 2>&1)" \
        || fail "could not read the entitlements of $1: $out"
    printf '%s\n' "$out"
}
for bundle in "$APP" "$WIDGET"; do
    ents="$(entitlements "$bundle")" || exit 1
    case "$ents" in
        *"<string>$APP_GROUP</string>"*) ;;
        *) fail "$bundle does not carry the App Group $APP_GROUP" ;;
    esac
    # The entitlement only grants the group; the binary opens the one named
    # in its Info.plist. Both expand $(TeamIdentifierPrefix), but in
    # different build phases, so a mismatch here would pass every
    # entitlement check and still leave the widget empty.
    info_group="$(plist RadarixAppGroup "$bundle/Contents/Info.plist")"
    [ "$info_group" = "$APP_GROUP" ] \
        || fail "$bundle reads RadarixAppGroup '$info_group' from its Info.plist, expected '$APP_GROUP'"
    # `-dvv`, not `-dv`: codesign prints `Authority=` lines only at
    # verbosity 2. Same team and hardened runtime on both, or notarization
    # rejects the widget or macOS refuses to load it into the app's group.
    sig="$(codesign -dvv "$bundle" 2>&1 || true)"
    case "$sig" in
        *"Authority=Developer ID Application"*) ;;
        *) fail "$bundle is not Developer ID signed" ;;
    esac
    case "$sig" in
        *"TeamIdentifier=$TEAM_ID"*) ;;
        *) fail "$bundle is not signed by team $TEAM_ID" ;;
    esac
    case "$sig" in
        *"(runtime)"*) ;;
        *) fail "$bundle lacks the hardened runtime" ;;
    esac
done
# The widget has to stay sandboxed: WidgetKit does not load an unsandboxed
# extension.
WIDGET_ENTS="$(entitlements "$WIDGET")" || exit 1
case "$WIDGET_ENTS" in
    *"com.apple.security.app-sandbox"*) ;;
    *) fail "the widget is not sandboxed" ;;
esac
echo "signed: $(codesign -dvv "$APP" 2>&1 | grep '^Authority=Developer ID Application')"

# --- notarize the app, staple it -------------------------------------------
ZIP="dist/Radarix-${VERSION}.zip"
ditto -c -k --keepParent "$APP" "$ZIP"
# `|| true`: a rejected submission exits non-zero, which under pipefail
# would abort HERE and skip the guidance below — the grep on the captured
# JSON is the single source of truth for acceptance.
xcrun notarytool submit "$ZIP" "${NOTARY_AUTH[@]}" --wait \
    --output-format json | tee dist/notary-app.json || true
grep -Eq '"status"[[:space:]]*:[[:space:]]*"Accepted"' dist/notary-app.json || {
    echo "error: app notarization not accepted — fetch the log with:" >&2
    echo "  xcrun notarytool log <submission-id> <same auth flags>" >&2
    exit 1; }
xcrun stapler staple "$APP"
rm -f "$ZIP"

# --- build the DMG from the STAPLED app, sign + notarize + staple it -------
rm -rf "$STAGING"; mkdir -p "$STAGING"
cp -R "$APP" "$STAGING/"
ln -s /Applications "$STAGING/Applications"
hdiutil create -volname "Radarix" -srcfolder "$STAGING" -ov -format UDZO "$DMG"
rm -rf "$STAGING"
codesign --force --timestamp --sign "$IDENTITY_HASH" "$DMG"

xcrun notarytool submit "$DMG" "${NOTARY_AUTH[@]}" --wait \
    --output-format json | tee dist/notary-dmg.json || true
grep -Eq '"status"[[:space:]]*:[[:space:]]*"Accepted"' dist/notary-dmg.json || {
    echo "error: DMG notarization not accepted — fetch the log with:" >&2
    echo "  xcrun notarytool log <submission-id> <same auth flags>" >&2
    exit 1; }
xcrun stapler staple "$DMG"

# --- final proof -----------------------------------------------------------
# `--deep` on the bundle: stapling writes into the app, and a copy step could
# break the seal over the embedded widget, which a check of the app's main
# binary alone would not notice.
codesign --verify --deep --strict "$APP"
spctl -a -t exec -vv "$APP"
spctl -a -t open --context context:primary-signature -v "$DMG"
xcrun stapler validate "$APP"
xcrun stapler validate "$DMG"
echo "RELEASE OK: $DMG"
